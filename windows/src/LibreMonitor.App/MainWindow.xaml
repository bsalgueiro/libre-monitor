<Window x:Class="LibreMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LibreMonitor.App"
        Title="Libre Monitor" Width="304" Height="196"
        MinWidth="224" MinHeight="148" MaxWidth="900" MaxHeight="640"
        SizeChanged="Window_SizeChanged"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" MouseWheel="Window_MouseWheel"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave">

    <Window.Resources>
        <!-- Defaults (dark); replaced at runtime when the theme changes. -->
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#EB171C23"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#26FFFFFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F5F9"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8B95A3"/>

        <!-- The default Thumb template paints a visible frame; the handles must stay invisible but hit-testable. -->
        <Style TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <!-- The 12px margin leaves room for the drop shadow. -->
    <Border x:Name="Card" Margin="12" CornerRadius="16"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <Border.ContextMenu>
            <ContextMenu x:Name="Menu" Opened="Menu_Opened">
                <!-- Graph -->
                <MenuItem x:Name="GraphItem" Header="Show graph" IsCheckable="True" Click="Graph_Click"/>
                <MenuItem x:Name="RangeMenu" Header="Time range">
                    <MenuItem x:Name="Range3" Header="Last 3 hours" Click="Range_Click" Tag="3"/>
                    <MenuItem x:Name="Range6" Header="Last 6 hours" Click="Range_Click" Tag="6"/>
                    <MenuItem x:Name="Range12" Header="Last 12 hours" Click="Range_Click" Tag="12"/>
                </MenuItem>
                <MenuItem Header="Units">
                    <MenuItem x:Name="UnitMg" Header="mg/dL" Click="Unit_Click" Tag="MgPerDl"/>
                    <MenuItem x:Name="UnitMmol" Header="mmol/L" Click="Unit_Click" Tag="MmolPerL"/>
                </MenuItem>
                <MenuItem Header="Appearance">
                    <MenuItem x:Name="ThemeSystem" Header="Follow system" Click="Theme_Click" Tag="System"/>
                    <MenuItem x:Name="ThemeLight" Header="Light" Click="Theme_Click" Tag="Light"/>
                    <MenuItem x:Name="ThemeDark" Header="Dark" Click="Theme_Click" Tag="Dark"/>
                </MenuItem>
                <Separator/>
                <!-- Alerts -->
                <MenuItem Header="Alerts..." Click="Alerts_Click"/>
                <MenuItem x:Name="InsulinItem" Header="Insulin: mark as administered" Click="InsulinMenu_Click" Visibility="Collapsed"/>
                <MenuItem x:Name="InsulinOffItem" Header="Turn off the insulin reminder" Click="InsulinOff_Click" Visibility="Collapsed"/>
                <MenuItem x:Name="InsulinSetupItem" Header="Set up the insulin reminder..." Click="Alerts_Click"/>
                <MenuItem x:Name="SnoozeMenu" Header="Snooze alerts">
                    <MenuItem Header="For 30 minutes" Click="Snooze_Click" Tag="30"/>
                    <MenuItem Header="For 1 hour" Click="Snooze_Click" Tag="60"/>
                    <MenuItem Header="For 2 hours" Click="Snooze_Click" Tag="120"/>
                    <Separator/>
                    <MenuItem x:Name="ResumeItem" Header="Resume alerts" Click="Resume_Click"/>
                </MenuItem>
                <Separator/>
                <!-- Sensor (only while the service names a sensor) -->
                <MenuItem x:Name="SensorItem" IsEnabled="False" Visibility="Collapsed"/>
                <MenuItem x:Name="SensorDurationMenu" Header="Sensor duration" Visibility="Collapsed"/>
                <Separator x:Name="SensorSeparator" Visibility="Collapsed"/>
                <!-- Position and window -->
                <MenuItem Header="Move to corner">
                    <MenuItem Header="Top left" Click="Corner_Click" Tag="TopLeft"/>
                    <MenuItem Header="Top right" Click="Corner_Click" Tag="TopRight"/>
                    <MenuItem Header="Bottom left" Click="Corner_Click" Tag="BottomLeft"/>
                    <MenuItem Header="Bottom right" Click="Corner_Click" Tag="BottomRight"/>
                </MenuItem>
                <MenuItem x:Name="TopmostItem" Header="Always on top" IsCheckable="True" Click="Topmost_Click"/>
                <MenuItem x:Name="TrayItem" Header="Show tray icon" IsCheckable="True" Click="TrayIcon_Click"/>
                <MenuItem x:Name="HideItem" Header="Hide to tray" Click="HideToTray_Click"/>
                <Separator/>
                <!-- App -->
                <MenuItem Header="Check for updates..." Click="Updates_Click"/>
                <MenuItem Header="About" Click="About_Click"/>
                <MenuItem Header="Sign out and exit" Click="SignOut_Click"/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid x:Name="ContentGrid" Margin="16,10,14,6">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="Auto"/>
                <RowDefinition x:Name="GraphRow" Height="*"/>
            </Grid.RowDefinitions>

            <!-- Two rows so the unit and age can sit under the value when the graph is hidden and the card is small. -->
            <Grid x:Name="HeaderGrid" Grid.Row="0" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="ValueStack" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="Transparent" MouseLeftButtonDown="Value_MouseLeftButtonDown">
                    <TextBlock x:Name="ValueText" Text="--" FontSize="46" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="ArrowText" FontSize="30" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- The unit and age, with the insulin syringe beside them, centred on the two lines. -->
                <StackPanel x:Name="InfoBlock" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                    <!-- Insulin check: grey = not due yet, amber ! = due, green tick = administered. Hidden unless the reminder is on. -->
                    <Grid x:Name="InsulinButton" Width="28" Height="28" VerticalAlignment="Center"
                          Margin="0,0,8,0" Background="Transparent" Cursor="Hand" Visibility="Collapsed"
                          MouseLeftButtonDown="Insulin_MouseLeftButtonDown"
                          ToolTipService.InitialShowDelay="150" ToolTipService.ShowDuration="12000">
                        <Viewbox Margin="0,1,1,0">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="SyringePath" StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M9,6 L15,6 L15,18 L9,18 Z M7,6 L17,6 M12,6 L12,2 M9,2 L15,2 M12,18 L12,23 M15,10 L13,10 M15,13 L13,13 M15,16 L13,16">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="45" CenterX="12" CenterY="12"/>
                                    </Path.RenderTransform>
                                </Path>
                            </Canvas>
                        </Viewbox>
                        <Border x:Name="InsulinBadge" Width="13" Height="13" CornerRadius="7" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Visibility="Collapsed">
                            <TextBlock x:Name="InsulinBadgeText" FontSize="9" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>
                    </Grid>
                    <StackPanel x:Name="InfoStack" VerticalAlignment="Center">
                        <TextBlock x:Name="UnitText" Text="mg/dL" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="AgeText" Text="connecting" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="CloseButton" Text="✕" FontSize="11" Foreground="{DynamicResource MutedBrush}" Opacity="0"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand"
                           MouseLeftButtonDown="Close_MouseLeftButtonDown" ContextMenuOpening="Close_ContextMenuOpening"/>
            </Grid>

            <!-- The graph draws its "now" dot 5px past its plot, so the plot ends exactly at the card padding like the left side. -->
            <local:GlucoseGraph x:Name="Graph" Grid.Row="1" Margin="0,2,-5,0"/>

        </Grid>
    </Border>

    <!-- Invisible resize handles along every edge and corner: the 12px shadow margin plus 6px inside the card. -->
    <Thumb Tag="L" Width="18" HorizontalAlignment="Left" Margin="0,24" Cursor="SizeWE" Background="Transparent" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted"/>
    <Thumb Tag="R" Width="18" HorizontalAlignment="Right" Margin="0,24" Cursor="SizeWE" Background="Transparent" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted"/>
    <Thumb Tag="T" Height="18" VerticalAlignment="Top" Margin="24,0" Cursor="SizeNS" Background="Transparent" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted"/>
    <Thumb Tag="B" Height="18" VerticalAlignment="Bottom" Margin="24,0" Cursor="SizeNS" Background="Transparent" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted"/>
    <Thumb Tag="TL" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Background="Transparent" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted"/>
    <Thumb Tag="TR" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="SizeNESW" Background="Transparent" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted"/>
    <Thumb Tag="BL" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Background="Transparent" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted"/>
    <Thumb Tag="BR" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Background="Transparent" DragDelta="Resize_DragDelta" DragCompleted="Resize_DragCompleted"/>
    </Grid>
</Window>
