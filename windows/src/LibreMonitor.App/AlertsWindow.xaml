<Window x:Class="LibreMonitor.App.AlertsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alerts" Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True">

    <Window.Resources>
        <!-- Defaults (dark); replaced at runtime from the current theme. -->
        <SolidColorBrush x:Key="TextBrush" Color="#F2F5F9"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8B95A3"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#5CD68A"/>
        <SolidColorBrush x:Key="LineBrush" Color="#33FFFFFF"/>

        <!-- Plain tabs that follow the theme: the system look would be a white box on the dark card. -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Padding="16,8" Margin="0,0,2,-1" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent" Background="Transparent" Cursor="Hand">
                            <ContentPresenter x:Name="Hdr" ContentSource="Header" TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="{DynamicResource MutedBrush}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Hdr" Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hdr" Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22">
        <CheckBox x:Name="PauseBox" Content="Pause all alerts" FontWeight="SemiBold" Checked="Pause_Changed" Unchecked="Pause_Changed"/>
        <TextBlock x:Name="PauseHint" Margin="22,2,0,0" TextWrapping="Wrap" FontSize="12"
                   Text="Nothing will notify you until you untick this. Changes here are applied as you make them."/>

        <TabControl x:Name="Tabs" Margin="0,14,0,0" Height="440">
            <!-- Glucose -->
            <TabItem Header="Glucose">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="GlucoseTab" Margin="2,16,10,4">
                        <TextBlock x:Name="IntroText" Margin="0,0,0,14" TextWrapping="Wrap"
                                   Text="Get a notification when a reading goes below or above your own limits. Both are off until you turn them on."/>

                        <CheckBox x:Name="LowBox" Content="Alert when glucose goes below" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="22,6,0,14">
                            <TextBox x:Name="LowValue" Width="72" Padding="5" VerticalContentAlignment="Center"/>
                            <TextBlock x:Name="LowUnit" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <CheckBox x:Name="HighBox" Content="Alert when glucose goes above" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="22,6,0,14">
                            <TextBox x:Name="HighValue" Width="72" Padding="5" VerticalContentAlignment="Center"/>
                            <TextBlock x:Name="HighUnit" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="While still out of range, remind me" FontWeight="SemiBold"/>
                        <ComboBox x:Name="RepeatBox" Width="190" Margin="0,6,0,14" HorizontalAlignment="Left">
                            <ComboBoxItem Content="Never (alert once)" Tag="0"/>
                            <ComboBoxItem Content="Every 15 minutes" Tag="15"/>
                            <ComboBoxItem Content="Every 30 minutes" Tag="30"/>
                            <ComboBoxItem Content="Every hour" Tag="60"/>
                        </ComboBox>

                        <TextBlock x:Name="DisclaimerText" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                                   Text="Alerts only work while this app is running, your PC is on and awake, and your phone is uploading. Readings can arrive minutes late, and Windows may hide notifications (for example in Focus mode). Do not rely on this for safety: keep your sensor's own alarms on."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Insulin -->
            <TabItem Header="Insulin">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="InsulinTab" Margin="2,16,10,4">
                        <TextBlock x:Name="InsulinIntroText" Margin="0,0,0,10" TextWrapping="Wrap"
                                   Text="A reminder at your usual time, and a syringe icon on the widget to tap once the dose is administered, so you can check later whether you already did. Off until you turn it on."/>

                        <CheckBox x:Name="InsulinBox" Content="Remind me to administer my insulin" FontWeight="SemiBold" Checked="Insulin_Changed" Unchecked="Insulin_Changed"/>
                        <StackPanel x:Name="InsulinPanel" Margin="22,8,0,0">
                            <ComboBox x:Name="DosesBox" Width="190" HorizontalAlignment="Left" SelectionChanged="Doses_SelectionChanged">
                                <ComboBoxItem Content="Once a day" Tag="1"/>
                                <ComboBoxItem Content="Twice a day" Tag="2"/>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock x:Name="FirstLabel" Text="Time" VerticalAlignment="Center" Width="70"/>
                                <TextBox x:Name="FirstTime" Width="64" Padding="5" VerticalContentAlignment="Center"/>
                                <TextBlock x:Name="TimeHint" Text="24-hour, like 08:00" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                            </StackPanel>
                            <StackPanel x:Name="SecondRow" Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock x:Name="SecondLabel" Text="Second time" VerticalAlignment="Center" Width="70"/>
                                <TextBox x:Name="SecondTime" Width="64" Padding="5" VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="InsulinRepeatLabel" Text="If not marked as administered, remind me" Margin="0,12,0,0"/>
                            <ComboBox x:Name="InsulinRepeatBox" Width="190" Margin="0,6,0,0" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Never (remind once)" Tag="0"/>
                                <ComboBoxItem Content="Every 15 minutes" Tag="15"/>
                                <ComboBoxItem Content="Every 30 minutes" Tag="30"/>
                                <ComboBoxItem Content="Every hour" Tag="60"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock x:Name="InsulinDisclaimerText" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12"
                                   Text="This is a memory aid only. It cannot know about a dose you did not tap, it does not record amounts, and it gives no dosing advice. Reminders stop 6 hours after the dose time. Follow your care team's instructions."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Sensor -->
            <TabItem Header="Sensor">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SensorTab" Margin="2,16,10,4">
                        <TextBlock x:Name="SensorIntroText" Margin="0,0,0,10" TextWrapping="Wrap"
                                   Text="Get a notification as your sensor gets close to its end. It is on by default."/>

                        <CheckBox x:Name="SensorBox" Content="Alert me before my sensor ends" FontWeight="SemiBold" Checked="Sensor_Changed" Unchecked="Sensor_Changed"/>
                        <StackPanel x:Name="SensorPanel" Margin="22,8,0,0">
                            <TextBlock Text="Start alerting" Margin="0,0,0,6"/>
                            <ComboBox x:Name="SensorDaysBox" Width="190" HorizontalAlignment="Left">
                                <ComboBoxItem Content="1 day before" Tag="1"/>
                                <ComboBoxItem Content="2 days before" Tag="2"/>
                                <ComboBoxItem Content="3 days before" Tag="3"/>
                                <ComboBoxItem Content="4 days before" Tag="4"/>
                                <ComboBoxItem Content="5 days before" Tag="5"/>
                                <ComboBoxItem Content="6 days before" Tag="6"/>
                                <ComboBoxItem Content="7 days before" Tag="7"/>
                            </ComboBox>
                            <TextBlock Text="Then repeat" Margin="0,12,0,6"/>
                            <ComboBox x:Name="SensorRepeatBox" Width="190" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Once a day" Tag="1440"/>
                                <ComboBoxItem Content="Every 6 hours" Tag="360"/>
                                <ComboBoxItem Content="Every hour" Tag="60"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock x:Name="SensorNoteText" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12"
                                   Text="The end date is an estimate: the sensor's start plus its duration. Set the duration (14 or 15 days) in the widget menu, under Sensor duration."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <CheckBox x:Name="SoundBox" Content="Play a sound" Margin="0,14,0,0"/>

        <TextBlock x:Name="InfoText" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#FF7B72" Visibility="Collapsed"/>

        <Grid Margin="0,18,0,0">
            <Button x:Name="TestButton" Content="Send test alert" Padding="12,6" HorizontalAlignment="Left" Click="Test_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Width="90" Padding="6" IsCancel="True" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
