<Window x:Class="LibreMonitor.App.AlertsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alerts" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True">
    <StackPanel Margin="24">
        <TextBlock x:Name="HeadingText" Text="Glucose alerts" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="IntroText" Margin="0,6,0,16" TextWrapping="Wrap"
                   Text="Get a notification when a reading goes below or above your own limits. Both are off until you turn them on."/>

        <CheckBox x:Name="LowBox" Content="Alert when glucose goes below" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Margin="22,6,0,14">
            <TextBox x:Name="LowValue" Width="72" Padding="5" VerticalContentAlignment="Center"/>
            <TextBlock x:Name="LowUnit" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <CheckBox x:Name="HighBox" Content="Alert when glucose goes above" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Margin="22,6,0,14">
            <TextBox x:Name="HighValue" Width="72" Padding="5" VerticalContentAlignment="Center"/>
            <TextBlock x:Name="HighUnit" Margin="8,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Text="While still out of range, remind me" FontWeight="SemiBold"/>
        <ComboBox x:Name="RepeatBox" Width="190" Margin="0,6,0,14" HorizontalAlignment="Left">
            <ComboBoxItem Content="Never (alert once)" Tag="0"/>
            <ComboBoxItem Content="Every 15 minutes" Tag="15"/>
            <ComboBoxItem Content="Every 30 minutes" Tag="30"/>
            <ComboBoxItem Content="Every hour" Tag="60"/>
        </ComboBox>

        <CheckBox x:Name="SoundBox" Content="Play a sound"/>

        <Separator Margin="0,16,0,12"/>

        <TextBlock Text="Insulin" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock x:Name="InsulinIntroText" Margin="0,4,0,10" TextWrapping="Wrap"
                   Text="A reminder at your usual time, and a syringe icon on the widget to tap once the dose is taken, so you can check later whether you already did. Off until you turn it on."/>

        <CheckBox x:Name="InsulinBox" Content="Remind me to take my insulin" FontWeight="SemiBold" Checked="Insulin_Changed" Unchecked="Insulin_Changed"/>
        <StackPanel x:Name="InsulinPanel" Margin="22,8,0,0">
            <ComboBox x:Name="DosesBox" Width="190" HorizontalAlignment="Left" SelectionChanged="Doses_SelectionChanged">
                <ComboBoxItem Content="Once a day" Tag="1"/>
                <ComboBoxItem Content="Twice a day" Tag="2"/>
            </ComboBox>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock x:Name="FirstLabel" Text="Time" VerticalAlignment="Center" Width="70"/>
                <TextBox x:Name="FirstTime" Width="64" Padding="5" VerticalContentAlignment="Center"/>
                <TextBlock x:Name="TimeHint" Text="24-hour, like 08:00" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
            <StackPanel x:Name="SecondRow" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock x:Name="SecondLabel" Text="Second time" VerticalAlignment="Center" Width="70"/>
                <TextBox x:Name="SecondTime" Width="64" Padding="5" VerticalContentAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="InsulinRepeatLabel" Text="If not marked as taken, remind me" Margin="0,12,0,0"/>
            <ComboBox x:Name="InsulinRepeatBox" Width="190" Margin="0,6,0,0" HorizontalAlignment="Left">
                <ComboBoxItem Content="Never (remind once)" Tag="0"/>
                <ComboBoxItem Content="Every 15 minutes" Tag="15"/>
                <ComboBoxItem Content="Every 30 minutes" Tag="30"/>
                <ComboBoxItem Content="Every hour" Tag="60"/>
            </ComboBox>
        </StackPanel>

        <TextBlock x:Name="InsulinDisclaimerText" Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                   Text="This is a memory aid only. It cannot know about a dose you did not tap, it does not record amounts, and it gives no dosing advice. Reminders stop 6 hours after the dose time. Follow your care team's instructions."/>

        <TextBlock x:Name="DisclaimerText" Margin="0,16,0,0" TextWrapping="Wrap" FontSize="12"
                   Text="Alerts only work while this app is running, your PC is on and awake, and your phone is uploading. Readings can arrive minutes late, and Windows may hide notifications (for example in Focus mode). Do not rely on this for safety: keep your sensor's own alarms on."/>

        <TextBlock x:Name="InfoText" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
        <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#FF7B72" Visibility="Collapsed"/>

        <Grid Margin="0,18,0,0">
            <Button x:Name="TestButton" Content="Send test alert" Padding="12,6" HorizontalAlignment="Left" Click="Test_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="90" Padding="6" Margin="0,0,8,0" IsCancel="True"/>
                <Button Content="Save" Width="90" Padding="6" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
