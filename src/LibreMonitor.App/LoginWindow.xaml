<Window x:Class="LibreMonitor.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" Background="#14181F" Foreground="#E8ECF2">
    <StackPanel Margin="24">
        <TextBlock Text="LibreLinkUp follower account" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Margin="0,6,0,16" TextWrapping="Wrap" Foreground="#9AA4B2"
                   Text="Use the second account that follows you in LibreLinkUp, not your main LibreLink login. The password is stored encrypted for your Windows user only."/>
        <TextBlock Text="Email"/>
        <TextBox x:Name="EmailBox" Margin="0,4,0,12" Padding="6"/>
        <TextBlock Text="Password"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,4,0,12" Padding="6" KeyDown="PasswordBox_KeyDown"/>
        <TextBlock x:Name="ErrorText" Foreground="#FF7B72" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Padding="6" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="SignInButton" Content="Sign in" Width="90" Padding="6" IsDefault="True" Click="SignIn_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
